# Облікові дані кабінету navkolo для автоматичного входу (використовуються, коли сесія відсутня або JWT прострочений)
DNTRADE_LOGIN=user@example.com
DNTRADE_PASSWORD=change-me
# Необов'язково: куди зберігати сесію (типово .dntrade-session.json поруч або вище по теках)
# DNTRADE_SESSION_FILE=/абсолютний/шлях/.dntrade-session.json
# Необов'язково: ідентифікатори акаунта (інакше визначаються через API або беруться типові)
# DNTRADE_ORGANIZATION_ID=1
# DNTRADE_STORE_ID=1
# DNTRADE_CASHBOX_ID=1
# DNTRADE_ACCOUNT_ID=1
# DNTRADE_PRICE_ID=2
# DNTRADE_PURCHASE_PRICE_ID=1
# DNTRADE_CURRENCY_ID=1
# DNTRADE_USER_ID=1
# DNTRADE_UNIT_ID=33
# DNTRADE_PARTNER_CATEGORY_ID=1
# DNTRADE_PRODUCT_CATEGORY_ID=1
